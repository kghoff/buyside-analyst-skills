{
 "section_title": "NON-GAAP METRICS",
 "insert_before": "BALANCE SHEET",
 "metrics": [
  {
   "key": "non-gaap gross profit",
   "rows": [
    {
     "role": "start",
     "label": "GAAP Gross Profit",
     "link": {
      "label": "^gross profit"
     }
    },
    {
     "role": "item",
     "label": "(+/-) Amortization of intangibles",
     "match": [
      "amortization.*intangible"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) Other Items",
     "match": [
      ".*"
     ]
    },
    {
     "role": "end",
     "label": "Non-GAAP Gross Profit"
    }
   ]
  },
  {
   "key": "non-gaap operating income",
   "rows": [
    {
     "role": "start",
     "label": "GAAP Operating Income",
     "link": {
      "label": "^operating income"
     }
    },
    {
     "role": "item",
     "label": "(+/-) Amortization of Intangibles",
     "match": [
      "amortization.*intangible"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) Other Items",
     "match": [
      "^(?!.*(intellectual property|litigation settlement)).*"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) IP Litigation Costs",
     "match": [
      "intellectual property litigation",
      "litigation settlement"
     ]
    },
    {
     "role": "end",
     "label": "Non-GAAP Operating Income"
    }
   ]
  },
  {
   "key": "adjusted ebitda",
   "rows": [
    {
     "role": "start",
     "label": "GAAP Net Income",
     "link": {
      "label": "^net income"
     }
    },
    {
     "role": "item",
     "label": "(+/-) Other Items",
     "match": [
      "^(?!.*(depreciation|share-based|interest expense and interest income|income tax|equity|intellectual property|litigation settlement)).*"
     ]
    },
    {
     "role": "link",
     "label": "(+/-) D&A",
     "match": [
      "^depreciation and amortization"
     ],
     "link": {
      "section": "CASH FLOW STATEMENT",
      "label": "depreciation"
     }
    },
    {
     "role": "item",
     "label": "(+/-) Equity Investment Gains / Losses",
     "match": [
      "equity (method )?investment"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) IP Litigation Costs",
     "match": [
      "intellectual property litigation",
      "litigation settlement"
     ]
    },
    {
     "role": "link",
     "label": "(+/-) SBC",
     "match": [
      "^share-based compensation"
     ],
     "link": {
      "section": "CASH FLOW STATEMENT",
      "label": "sbc"
     }
    },
    {
     "role": "item",
     "label": "(+) Interest Income / (-) Interest Expense",
     "match": [
      "interest expense and interest income"
     ]
    },
    {
     "role": "link",
     "label": "(+/-) Income Tax",
     "match": [
      "^income tax"
     ],
     "link": {
      "label": "income taxes",
      "sign": -1
     }
    },
    {
     "role": "end",
     "label": "Adjusted EBITDA"
    }
   ]
  },
  {
   "key": "non-gaap net income",
   "rows": [
    {
     "role": "start",
     "label": "GAAP Net Income",
     "link": {
      "label": "^net income"
     }
    },
    {
     "role": "item",
     "label": "(+/-) Amortization of Intangibles",
     "match": [
      "amortization.*intangible"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) Equity Investment Gains / Losses",
     "match": [
      "equity (method )?investment"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) Other Items",
     "match": [
      "^(?!.*(intellectual property|litigation settlement|tax)).*"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) IP Litigation Costs",
     "match": [
      "intellectual property litigation",
      "litigation settlement"
     ]
    },
    {
     "role": "item",
     "label": "(+/-) Adjustments related to taxes",
     "match": [
      "tax"
     ]
    },
    {
     "role": "end",
     "label": "Non-GAAP Net Income"
    }
   ]
  }
 ],
 "eps": {
